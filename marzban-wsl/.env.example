# ==============================================================================
# Marzban Dashboard Configuration for WSL Ubuntu
# ==============================================================================

# Web Dashboard Port & Host
UVICORN_PORT=8000
UVICORN_HOST=0.0.0.0

# Database Storage (SQLite in persistent volume)
SQLALCHEMY_DATABASE_URL="sqlite:////var/lib/marzban/db.sqlite3"

# Subscription URL Prefix:
# Set this to your VPS public IP so generated subscription links point to the VPS
# e.g., http://<VPS_PUBLIC_IP>:8000
XRAY_SUBSCRIPTION_URL_PREFIX="http://127.0.0.1:8000"

# Xray Configuration File Path inside container
XRAY_JSON="/var/lib/marzban/xray_config.json"

# Session Expiration (in minutes; 10080 = 7 days)
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Log Level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL="INFO"
