# ==============================================================================
# WireGuard Gateway Configuration (.env)
# ==============================================================================

# Public IP address or Fully Qualified Domain Name (FQDN) of your VPS
# WireGuard clients will connect to this host.
WG_HOST=your-vps-ip-or-domain.com

# Web UI Admin Port (default: 51821)
PORT=51821

# Web UI Access Protocol:
# Set to 'true' if accessing directly via HTTP (e.g. http://your-ip:51821)
# Set to 'false' if running behind an SSL reverse proxy (Nginx, Caddy, Traefik)
INSECURE=true

# Admin Password Configuration:
# For wg-easy v14+, you can generate a secure bcrypt hash:
#   docker run -it --rm ghcr.io/wg-easy/wg-easy:15 wgpw "YourSecurePassword"
# Paste the resulting bcrypt string into PASSWORD_HASH below:
PASSWORD_HASH=

# Fallback Plaintext Password:
# (Used if PASSWORD_HASH is blank)
PASSWORD=ChangeThisSecretPassword123!

# WireGuard VPN Port (UDP)
WG_PORT=51820

# WireGuard Client IP Pool
WG_DEFAULT_ADDRESS=10.8.0.x

# DNS Servers assigned to WireGuard clients (Cloudflare / Quad9)
WG_DEFAULT_DNS=1.1.1.1,1.0.0.1

# Persistent Keepalive interval in seconds (maintains NAT state on firewalls)
WG_PERSISTENT_KEEPALIVE=25

# Client MTU
WG_MTU=1420

# Docker image release tag
WG_EASY_TAG=15

# ==============================================================================
# Unattended Setup (wg-easy v15+)
# ==============================================================================
INIT_ENABLED=true
INIT_USERNAME=admin
INIT_PASSWORD=ChangeThisSecretPassword123!
INIT_IPV4_CIDR=10.8.0.0/24

# ==============================================================================
# Discord AllowedIPs Configuration
# ==============================================================================
# Populate this automatically by running:
#   ./fetch-discord-cidrs.sh --update-env
#
# When set, any new client config generated by wg-easy will automatically
# only route Discord CIDRs and DNS through the tunnel (split tunneling).
WG_ALLOWED_IPS=
INIT_ALLOWED_IPS=
